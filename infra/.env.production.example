# Copy to infra/.env.production. Use a URL-safe hexadecimal database password.
PROFLIGATOR_POSTGRES_PASSWORD=replace-with-random-hex
PROFLIGATOR_AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
PROFLIGATOR_PUBLIC_WEB_URL=https://your-domain.example
PROFLIGATOR_ENVIRONMENT=production
PROFLIGATOR_AUTH_COOKIE_SECURE=true
PROFLIGATOR_WEB_PORT=8080
# Set these after adding the production callback to the Google OAuth client.
PROFLIGATOR_GOOGLE_CLIENT_ID=
PROFLIGATOR_GOOGLE_CLIENT_SECRET=
PROFLIGATOR_GOOGLE_REDIRECT_URI=
PROFLIGATOR_PASSWORD_RESET_EMAIL_BACKEND=disabled
PROFLIGATOR_SMTP_HOST=smtp.gmail.com
PROFLIGATOR_SMTP_PORT=587
PROFLIGATOR_SMTP_SECURITY=starttls
PROFLIGATOR_SMTP_USERNAME=
PROFLIGATOR_SMTP_PASSWORD=
PROFLIGATOR_SMTP_FROM_EMAIL=
PROFLIGATOR_MATCHING_BACKEND=disabled
PROFLIGATOR_MATCHING_MODEL=
PROFLIGATOR_GROQ_API_KEY=
PROFLIGATOR_GROQ_MIN_INTERVAL_SECONDS=2.1
PROFLIGATOR_LEETCODE_CONNECTOR=scraper
PROFLIGATOR_GEEKSFORGEEKS_CONNECTOR=scraper

# Separate sender for account email verification.
PROFLIGATOR_VERIFICATION_EMAIL_BACKEND=disabled
PROFLIGATOR_VERIFICATION_SMTP_HOST=smtp.gmail.com
PROFLIGATOR_VERIFICATION_SMTP_PORT=587
PROFLIGATOR_VERIFICATION_SMTP_SECURITY=starttls
PROFLIGATOR_VERIFICATION_SMTP_USERNAME=
PROFLIGATOR_VERIFICATION_SMTP_PASSWORD=
PROFLIGATOR_VERIFICATION_SMTP_FROM_EMAIL=
# Public hostname for the optional HTTPS proxy overlay.
PROFLIGATOR_DOMAIN=your-domain.example
