PROFLIGATOR_DATABASE_URL=postgresql+psycopg://profligator:profligator@localhost:5432/profligator
PROFLIGATOR_AUTO_CREATE_SCHEMA=false
PROFLIGATOR_CODEFORCES_BASE_URL=https://codeforces.com/api
PROFLIGATOR_CODEFORCES_MIN_INTERVAL_SECONDS=2.05
PROFLIGATOR_CORS_ORIGINS=["http://localhost:5173"]
PROFLIGATOR_SYNC_BACKEND=rq
PROFLIGATOR_REDIS_URL=redis://localhost:6379/0
PROFLIGATOR_SYNC_QUEUE_NAME=profligator-syncs
PROFLIGATOR_SYNC_JOB_TIMEOUT_SECONDS=300
PROFLIGATOR_SYNC_MAX_ATTEMPTS=3
PROFLIGATOR_SYNC_RETRY_BASE_SECONDS=1.0
PROFLIGATOR_AUTH_SECRET_KEY=replace-with-at-least-32-random-bytes
PROFLIGATOR_AUTH_ISSUER=profligator-api
PROFLIGATOR_AUTH_AUDIENCE=profligator-web
PROFLIGATOR_ACCESS_TOKEN_MINUTES=15
PROFLIGATOR_REFRESH_TOKEN_DAYS=30
PROFLIGATOR_AUTH_COOKIE_SECURE=false
PROFLIGATOR_PUBLIC_WEB_URL=http://localhost:5173
# Enable smtp after configuring the sender and its Google app password.
PROFLIGATOR_PASSWORD_RESET_EMAIL_BACKEND=disabled
PROFLIGATOR_PASSWORD_RESET_MINUTES=15
PROFLIGATOR_SMTP_HOST=smtp.gmail.com
PROFLIGATOR_SMTP_PORT=587
PROFLIGATOR_SMTP_SECURITY=starttls
# PROFLIGATOR_SMTP_USERNAME=sender@example.com
# PROFLIGATOR_SMTP_PASSWORD=google-app-password
# PROFLIGATOR_SMTP_FROM_EMAIL=sender@example.com
# Google Cloud OAuth client with application type "Web application".
# Keep these server-side. Callback must exactly match Google's authorized redirect URI.
# PROFLIGATOR_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# PROFLIGATOR_GOOGLE_CLIENT_SECRET=your-client-secret
# PROFLIGATOR_GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback
PROFLIGATOR_SYNC_INTERVAL_SECONDS=21600
PROFLIGATOR_PROFILE_SYNC_COOLDOWN_SECONDS=900
PROFLIGATOR_SCHEDULER_POLL_SECONDS=60
PROFLIGATOR_MATCHING_BACKEND=disabled
PROFLIGATOR_MATCHING_BASE_URL=http://localhost:11434
PROFLIGATOR_MATCHING_MODEL=
# Hosted comparison: set MATCHING_BACKEND=groq and MATCHING_MODEL=openai/gpt-oss-120b.
# Key belongs in apps/api/.env, never the web/extension bundle.
# PROFLIGATOR_GROQ_API_KEY=your-groq-api-key
PROFLIGATOR_GROQ_MIN_INTERVAL_SECONDS=2.1
PROFLIGATOR_GROQ_MAX_COMPLETION_TOKENS=2048
PROFLIGATOR_GROQ_MAX_INPUT_CHARS=16000
PROFLIGATOR_MATCHING_MIN_CONFIDENCE=0.95
PROFLIGATOR_MATCHING_TIMEOUT_SECONDS=30
PROFLIGATOR_MATCHING_CANDIDATE_LIMIT=8
PROFLIGATOR_MATCHING_MAX_COMPARISONS=64
PROFLIGATOR_MATCHING_RUN_TIMEOUT_SECONDS=60
PROFLIGATOR_MATCHING_CHECK_TIMEOUT_SECONDS=10
# Scoped, revocable browser connections; Google credentials remain on the API.
PROFLIGATOR_EXTENSION_SESSION_DAYS=30
# Public-provider history refresh cooldown, including acceptance tracking.
PROFLIGATOR_EXTENSION_HISTORY_COOLDOWN_SECONDS=60
# Optional operator-controlled public-data service; see docs/backend-design.md.
# PROFLIGATOR_AGGREGATION_SERVICE_URL=http://localhost:8080
# Set either platform to fixture for offline demo data. Scrapers are the default.
PROFLIGATOR_LEETCODE_CONNECTOR=scraper
# Focus on solved questions; enable contest statistics only when that feature resumes.
PROFLIGATOR_LEETCODE_COLLECT_CONTESTS=false
PROFLIGATOR_GEEKSFORGEEKS_CONNECTOR=scraper
PROFLIGATOR_SCRAPER_MIN_INTERVAL_SECONDS=2.05
PROFLIGATOR_SCRAPER_STATEMENT_LIMIT=20
PROFLIGATOR_SCRAPER_CALENDAR_YEAR_LIMIT=3

# Independent sender for account inbox verification. Never commit app passwords.
PROFLIGATOR_VERIFICATION_EMAIL_BACKEND=disabled
PROFLIGATOR_VERIFICATION_SMTP_HOST=smtp.gmail.com
PROFLIGATOR_VERIFICATION_SMTP_PORT=587
PROFLIGATOR_VERIFICATION_SMTP_SECURITY=starttls
PROFLIGATOR_VERIFICATION_SMTP_USERNAME=
PROFLIGATOR_VERIFICATION_SMTP_PASSWORD=
PROFLIGATOR_VERIFICATION_SMTP_FROM_EMAIL=
